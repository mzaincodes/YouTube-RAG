# ============================================================================
#  YouTube RAG — environment configuration
#  Copy this file to `.env` and fill in GOOGLE_API_KEY. Nothing else is required.
# ============================================================================

# ---------------------------------------------------------------------------
# REQUIRED — Google Gemini API key.
# Get a free key at https://aistudio.google.com/apikey
# ---------------------------------------------------------------------------
GOOGLE_API_KEY=

# ---------------------------------------------------------------------------
# Models
# ---------------------------------------------------------------------------
# Chat model. Prefer the *-latest aliases: Google retires concrete model names,
# and older ones (e.g. gemini-2.5-flash) return 404 'no longer available to new
# users' for recently created API keys even though they still appear in the
# models list. If this model is unavailable the app falls back automatically.
# Alternatives: gemini-3.6-flash, gemini-3.5-flash, gemini-flash-lite-latest,
# gemini-pro-latest (pro models often exceed free-tier quota).
MODEL_NAME=gemini-flash-latest

# Embedding model used for both indexing and querying.
# If this model is unavailable for your key the app automatically falls back to
# models/text-embedding-004, then models/embedding-001.
# IMPORTANT: changing this after indexing invalidates the existing vectors —
# clear the database and re-index, or the app will warn you on startup.
EMBEDDING_MODEL=models/gemini-embedding-001

# Sampling temperature (0.0 = deterministic). Low values suit grounded RAG.
TEMPERATURE=0.2
MAX_OUTPUT_TOKENS=4096

# ---------------------------------------------------------------------------
# Vector database (ChromaDB, persistent on disk)
# ---------------------------------------------------------------------------
CHROMA_DB_PATH=./chroma_db
# 3-512 chars, [a-zA-Z0-9._-], must start and end alphanumeric.
CHROMA_COLLECTION=youtube_rag

# ---------------------------------------------------------------------------
# Chunking
# ---------------------------------------------------------------------------
# Target chunk size in characters, and how much of the previous chunk is
# carried into the next one for context continuity.
CHUNK_SIZE=1200
CHUNK_OVERLAP=200

# Semantic (topic-preserving) chunking. When true, sentences are embedded and
# chunk boundaries are placed where the topic actually shifts. Costs one extra
# embedding pass per video; set to false to use pure structural chunking.
SEMANTIC_CHUNKING=true

# Distance percentile above which a sentence gap counts as a topic change.
# Higher = fewer, larger chunks. 90-95 works well for talks and lectures.
SEMANTIC_BREAKPOINT_PERCENTILE=90
SEMANTIC_MIN_CHUNK_CHARS=400

# Cost guard: transcripts with more sentence/window units than this skip the
# semantic pass and use structural chunking instead, bounding embedding spend
# on multi-hour videos.
SEMANTIC_MAX_SENTENCES_PROBE=1500

# ---------------------------------------------------------------------------
# Embedding throughput
# ---------------------------------------------------------------------------
# Google caps a single embedding request at 100 inputs.
EMBED_BATCH_SIZE=64
MAX_RETRIES=5
RETRY_BASE_DELAY=1.5

# ---------------------------------------------------------------------------
# Retrieval
# ---------------------------------------------------------------------------
# Chunks passed to the model per question.
RETRIEVAL_K=6
# Candidates fetched before MMR diversification (must be >= RETRIEVAL_K).
RETRIEVAL_FETCH_K=24
# "mmr" diversifies results; "similarity" returns the nearest neighbours.
SEARCH_TYPE=mmr
# 0.0 = pure diversity, 1.0 = pure relevance.
MMR_LAMBDA=0.55
# Drop chunks scoring below this (0-1). 0 disables the filter.
SCORE_THRESHOLD=0.0

# ---------------------------------------------------------------------------
# Conversation
# ---------------------------------------------------------------------------
# Exchanges of history kept for follow-up questions and query rewriting.
HISTORY_TURNS=6
# Hard cap on characters of retrieved context sent to the model.
MAX_CONTEXT_CHARS=24000

# ---------------------------------------------------------------------------
# Transcripts
# ---------------------------------------------------------------------------
# Preferred caption languages, in order. Falls back to any available language
# (translated when possible) if none of these exist.
TRANSCRIPT_LANGUAGES=en,en-US,en-GB
# Videos fetched in parallel.
TRANSCRIPT_MAX_WORKERS=4

# ---------------------------------------------------------------------------
# Logging: DEBUG | INFO | WARNING | ERROR
# ---------------------------------------------------------------------------
LOG_LEVEL=INFO
